: 1769539662:5;cat <<'EOF' > /home/granted/carcino-fighters-website/app/admin/docs/[docId]/edit/page.tsx\
"use client";\
\
import dynamic from "next/dynamic";\
import Image from "next/image";\
import { useEffect, useMemo, useState } from "react";\
import { useParams, useRouter } from "next/navigation";\
import type { AdminUser, CancerDoc } from "@/components/admin/cancer-docs-panel";\
import "@uiw/react-md-editor/markdown-editor.css";\
import "@uiw/react-markdown-preview/markdown.css";\
\
const MDEditor = dynamic(() => import("@uiw/react-md-editor"), { ssr: false });\
\
type DocForm = {\
  slug: string;\
  title: string;\
  content: string;\
  authorId: string;\
  position: string;\
};\
\
type EditorStatus = "idle" | "saving" | "saved";\
\
type SlimUser = Pick<AdminUser, "id" | "name" | "username" | "email" | "position">;\
\
export default function DocEditorPage() {\
  const params = useParams<{ docId: string }>();\
  const docId = params?.docId as string;\
  const router = useRouter();\
\
  const [currentUser, setCurrentUser] = useState<AdminUser | null>(null);\
  const [doc, setDoc] = useState<CancerDoc | null>(null);\
  const [form, setForm] = useState<DocForm>({ slug: "", title: "", content: "", authorId: "", position: "" });\
  const [users, setUsers] = useState<SlimUser[]>([]);\
  const [authorSearch, setAuthorSearch] = useState("");\
  const [error, setError] = useState<string | null>(null);\
  const [status, setStatus] = useState<EditorStatus>("idle");\
  const [loading, setLoading] = useState(true);\
  const [editorTheme, setEditorTheme] = useState<"light" | "dark">("light");\
\
  useEffect(() => {\
    const syncTheme = () => {\
      const prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;\
      const hasDarkClass = document.documentElement.classList.contains("dark");\
      setEditorTheme(prefersDark || hasDarkClass ? "dark" : "light");\
    };\
    syncTheme();\
\
    const mq = window.matchMedia("(prefers-color-scheme: dark)");\
    const listener = () => syncTheme();\
    mq.addEventListener("change", listener);\
    return () => mq.removeEventListener("change", listener);\
  }, []);\
\
  useEffect(() => {\
    const bootstrap = async () => {\
      if (!docId) return;\
      setLoading(true);\
      setError(null);\
\
      try {\
        const sessionRes = await fetch("/api/admin", { method: "GET" });\
        const sessionData = await sessionRes.json().catch(() => ({}));\
        if (!sessionRes.ok || !sessionData?.authenticated) {\
          router.replace("/admin/login");\
          return;\
        }\
        setCurrentUser(sessionData.user ?? null);\
\
        if (sessionData.user?.admin_access) {\
          fetchUsers();\
        }\
\
        await fetchDoc();\
      } catch (err) {\
        console.error("bootstrap error", err);\
        setError("Failed to load editor");\
      } finally {\
        setLoading(false);\
      }\
    };\
\
    bootstrap();\
    // eslint-disable-next-line react-hooks/exhaustive-deps\
  }, [docId]);\
\
  async function fetchUsers() {\
    try {\
      const res = await fetch("/api/admin", {\
        method: "POST",\
        headers: { "Content-Type": "application/json" },\
        body: JSON.stringify({ action: "list_users" }),\
      });\
      const data = await res.json().catch(() => ({}));\
      if (res.ok && Array.isArray(data.users)) {\
        const slim = data.users.map((u: AdminUser) => ({\
          id: u.id,\
          name: u.name,\
          username: u.username,\
          email: u.email,\
          position: u.position,\
        }));\
        setUsers(slim);\
      }\
    } catch (err) {\
      console.error("fetchUsers error", err);\
    }\
  }\
\
  async function fetchDoc() {\
    try {\
      const res = await fetch("/api/admin", {\
        method: "POST",\
        headers: { "Content-Type": "application/json" },\
        body: JSON.stringify({ action: "get_doc", docId }),\
      });\
      const data = await res.json().catch(() => ({}));\
      if (!res.ok) {\
        setError(data?.error || "Failed to load document");\
        return;\
      }\
      const docData = data.doc as CancerDoc;\
      setDoc(docData);\
      setForm({\
        slug: docData.slug ?? "",\
        title: docData.title ?? "",\
        content: docData.content ?? "",\
        authorId: docData.author_user_id ?? "",\
        position: docData.position ?? "",\
      });\
    } catch (err) {\
      console.error("fetchDoc error", err);\
      setError("Failed to load document");\
    }\
  }\
\
  const filteredAuthors = useMemo(() => {\
    if (!authorSearch.trim()) return users.slice(0, 12);\
    const term = authorSearch.toLowerCase();\
    return users\
      .filter((u) => [u.name, u.username, u.email, u.position].filter(Boolean).some((v) => String(v).toLowerCase().includes(term)))\
      .slice(0, 12);\
  }, [authorSearch, users]);\
\
  async function handleSave() {\
    if (!docId) return;\
    setStatus("saving");\
    setError(null);\
    try {\
      const body: Record<string, unknown> = {\
        action: "update_doc",\
        docId,\
        slug: form.slug,\
        title: form.title,\
        content: form.content,\
        position: form.position,\
      };\
      if (currentUser?.admin_access) {\
        body.authorId = form.authorId || null;\
      }\
      const res = await fetch("/api/admin", {\
        method: "POST",\
        headers: { "Content-Type": "application/json" },\
        body: JSON.stringify(body),\
      });\
      const data = await res.json().catch(() => ({}));\
      if (!res.ok) {\
        setError(data?.error || "Failed to save changes");\
        setStatus("idle");\
        return;\
      }\
      setStatus("saved");\
      if (data.doc) setDoc(data.doc);\
      setTimeout(() => setStatus("idle"), 2000);\
    } catch (err) {\
      console.error("save error", err);\
      setError("Failed to save changes");\
      setStatus("idle");\
    }\
  }\
\
  if (loading) {\
    return (\
      <div className="min-h-screen flex items-center justify-center bg-background px-4">\
        <div className="flex items-center gap-3 text-sm text-muted-foreground">\
          <span className="h-4 w-4 animate-spin rounded-full border-2 border-primary border-t-transparent" />\
          Loading editor...\
        </div>\
      </div>\
    );\
  }\
\
  if (!doc) {\
    return (\
      <div className="min-h-screen flex items-center justify-center bg-background px-4">\
        <div className="max-w-lg text-center space-y-3">\
          <h1 className="text-2xl font-semibold">Document not found</h1>\
          <p className="text-muted-foreground text-sm">It may have been deleted or you do not have permission to edit it.</p>\
          <button className="bg-primary text-primary-foreground px-4 py-2 rounded" onClick={() => router.replace("/admin")}>Back to dashboard</button>\
        </div>\
      </div>\
    );\
  }\
\
  const canChangeAuthor = Boolean(currentUser?.admin_access);\
  const currentAuthorLabel =\
    users.find((u) => u.id === form.authorId)?.name ||\
    doc.author_name ||\
    doc.author_username ||\
    "Select an author";\
\
  return (\
    <div className="min-h-screen bg-background px-4 py-8 pt-[72px]">\
      <div className="max-w-6xl mx-auto space-y-6">\
        <div className="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">\
          <div className="space-y-1">\
            <button className="text-sm text-muted-foreground hover:underline" onClick={() => router.push("/admin")}>âƒ¦ƒ° Back to admin</button>\
            <h1 className="text-2xl font-bold">Editing: {doc.title}</h1>\
            <p className="text-sm text-muted-foreground">Write in full Markdown with live preview. Changes save to the same API you already use.</p>\
          </div>\
          <div className="flex items-center gap-2 flex-wrap">\
            {status === "saved" && <span className="text-xs px-3 py-1 rounded-full bg-green-100 text-green-700">Saved</span>}\
            <button\
              className="bg-primary text-primary-foreground px-4 py-2 rounded font-semibold shadow-sm"\
              onClick={handleSave}\
              disabled={status === "saving"}\
            >\
              {status === "saving" ? "Saving..." : "Save changes"}\
            </button>\
          </div>\
        </div>\
\
        {error && (\
          <div className="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">\
            {error}\
          </div>\
        )}\
\
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">\
          <div className="lg:col-span-2 space-y-4">\
            <div className="rounded-2xl border bg-card shadow-sm p-4 space-y-3">\
              <div className="grid grid-cols-1 md:grid-cols-2 gap-3">\
                <div className="space-y-1">\
                  <label className="text-xs text-muted-foreground" htmlFor="title">Title</label>\
                  <input\
                    id="title"\
                    className="border rounded px-3 py-2 w-full bg-background"\
                    value={form.title}\
                    onChange={(e) => setForm((s) => ({ ...s, title: e.target.value }))}\
                  />\
                </div>\
                <div className="space-y-1">\
                  <label className="text-xs text-muted-foreground" htmlFor="slug">Slug</label>\
                  <input\
                    id="slug"\
                    className="border rounded px-3 py-2 w-full bg-background font-mono"\
                    value={form.slug}\
                    onChange={(e) => setForm((s) => ({ ...s, slug: e.target.value }))}\
                  />\
                </div>\
                <div className="space-y-1">\
                  <label className="text-xs text-muted-foreground" htmlFor="position">Position (optional)</label>\
                  <input\
                    id="position"\
                    className="border rounded px-3 py-2 w-full bg-background"\
                    value={form.position}\
                    onChange={(e) => setForm((s) => ({ ...s, position: e.target.value }))}\
                  />\
                </div>\
                <div className="space-y-1">\
                  <label className="text-xs text-muted-foreground">Author</label>\
                  {canChangeAuthor ? (\
                    <div className="space-y-2">\
                      <input\
                        className="border rounded px-3 py-2 w-full bg-background"\
                        placeholder="Search authors..."\
                        value={authorSearch}\
                        onChange={(e) => setAuthorSearch(e.target.value)}\
                      />\
                      <div className="rounded-lg border bg-popover shadow-sm max-h-48 overflow-auto divide-y">\
                        {filteredAuthors.map((u) => (\
                          <button\
                            type="button"\
                            key={u.id}\
                            className={`w-full text-left px-3 py-2 text-sm hover:bg-muted ${form.authorId === u.id ? "bg-muted" : ""}`}\
                            onClick={() => setForm((s) => ({ ...s, authorId: u.id }))}\
                          >\
                            <div className="font-medium leading-tight">{u.name || u.username || u.email || "(no name)"}</div>\
                            <div className="text-xs text-muted-foreground">{u.position || ""}</div>\
                          </button>\
                        ))}\
                        <button\
                          type="button"\
                          className="w-full text-left px-3 py-2 text-sm text-red-600 hover:bg-muted"\
                          onClick={() => setForm((s) => ({ ...s, authorId: "" }))}\
                        >\
                          Clear author\
                        </button>\
                      </div>\
                      <div className="text-xs text-muted-foreground">\
                        Current: {currentAuthorLabel}\
                      </div>\
                    </div>\
                  ) : (\
                    <div className="text-sm font-medium">{currentAuthorLabel}</div>\
                  )}\
                </div>\
              </div>\
            </div>\
\
            <div className="rounded-2xl border bg-card shadow-sm p-4">\
              <div className="flex items-center justify-between mb-3">\
                <div>\
                  <div className="text-xs uppercase tracking-[0.1em] text-muted-foreground">Markdown Editor</div>\
                  <p className="text-sm text-muted-foreground">Toolbar + live preview powered by @uiw/react-md-editor.</p>\
                </div>\
                <span className="text-xs rounded-full border px-2 py-1 text-muted-foreground">Theme: {editorTheme}</span>\
              </div>\
              <div data-color-mode={editorTheme} className="rounded-xl overflow-hidden border shadow-sm">\
                <MDEditor\
                  value={form.content}\
                  onChange={(val) => setForm((s) => ({ ...s, content: val ?? "" }))}\
                  height={520}\
                  preview="live"\
                  visibleDragbar={false}\
                />\
              </div>\
            </div>\
          </div>\
\
          <aside className="space-y-4">\
            <div className="rounded-2xl border bg-card shadow-sm p-4 space-y-3">\
              <div className="flex items-center gap-3">\
                {doc.profilePicture ? (\
                  <Image src={doc.profilePicture} alt="author avatar" width={56} height={56} className="h-14 w-14 rounded-full object-cover" unoptimized />\
                ) : (\
                  <div className="h-14 w-14 rounded-full bg-muted" />\
                )}\
                <div>\
                  <div className="text-xs text-muted-foreground">Author</div>\
                  <div className="font-semibold leading-tight">{currentAuthorLabel}</div>\
                  {doc.author_position && <div className="text-xs text-muted-foreground">{doc.author_position}</div>}\
                </div>\
              </div>\
              <div className="text-sm text-muted-foreground">\
                Changes are persisted through the same admin API. Markdown supports headings, lists, code, links, and tables.\
              </div>\
            </div>\
\
            <div className="rounded-2xl border bg-card shadow-sm p-4 space-y-3">\
              <h3 className="text-sm font-semibold">Quick format tips</h3>\
              <ul className="text-sm text-muted-foreground space-y-1 list-disc list-inside">\
                <li>Use `##` for section headings.</li>\
                <li>Triple backticks for code blocks.</li>\
                <li>Use `-` for bullet lists and `1.` for numbered lists.</li>\
                <li>Insert links with `[text](https://example.com)`.</li>\
              </ul>\
            </div>\
\
            <div className="rounded-2xl border bg-card shadow-sm p-4 space-y-3">\
              <h3 className="text-sm font-semibold">Actions</h3>\
              <div className="flex flex-col gap-2">\
                <button\
                  className="bg-primary text-primary-foreground px-4 py-2 rounded font-semibold"\
                  onClick={handleSave}\
                  disabled={status === "saving"}\
                >\
                  {status === "saving" ? "Saving..." : "Save changes"}\
                </button>\
                <button\
                  className="border px-4 py-2 rounded"\
                  onClick={() => router.push("/admin")}\
                >\
                  Back to dashboard\
                </button>\
              </div>\
            </div>\
          </aside>\
        </div>\
      </div>\
    </div>\
  );\
}\
EOF
