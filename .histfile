: 1767995628:0;cat > import-users.mjs <<'EOF'\
import fs from "node:fs";\
import path from "node:path";\
import assert from "node:assert";\
\
const API_BASE = process.env.API_BASE ?? "http://localhost:3000";\
const CSV_PATH = process.env.CSV_PATH ?? path.join(process.cwd(), "users.csv");\
const DEFAULT_PASSWORD = process.env.DEFAULT_PASSWORD ?? "ChangeMe123!";\
\
const csv = fs.readFileSync(CSV_PATH, "utf8").trim().split("\n");\
assert(csv.length > 1, "CSV appears empty");\
const rows = csv.slice(1); // skip header\
\
const slugifyName = (name) =>\
  name\
    .toLowerCase()\
    .replace(/\s+/g, "")\
    .replace(/[^a-z0-9]/g, "");\
\
for (const line of rows) {\
  const [name, , , email] = line.split(",");\
  if (!email || email === "-" || !name) {\
    console.log("skip (missing email/name):", line);\
    continue;\
  }\
  const username = slugifyName(name);\
  const payload = {\
    action: "register",\
    username,\
    email,\
    password: DEFAULT_PASSWORD,\
    name,\
  };\
\
  const res = await fetch(`${API_BASE}/api/admin`, {\
    method: "POST",\
    headers: { "Content-Type": "application/json" },\
    body: JSON.stringify(payload),\
  });\
\
  const body = await res.json().catch(() => ({}));\
  if (!res.ok) {\
    console.error("fail", res.status, username, email, body);\
  } else {\
    console.log("ok  ", username, email, body.user?.id ?? "");\
  }\
}\
