from board import Board\
from move import Move\
from square import Square\
\
b = Board()\
\
def mv(fr, fc, tr, tc):\
    piece = b.squares[fr][fc].piece\
    b.move(piece, Move(Square(fr, fc), Square(tr, tc)))\
\
# free white king-side: Ng1-f3, Bf1-c4, castle Ke1-g1\
mv(7, 6, 5, 5)  # knight\
mv(7, 5, 4, 2)  # bishop\
mv(7, 4, 7, 6)  # castle king move; should also move rook h1->f1 now\
print("After white O-O: rook at f1?", isinstance(b.squares[7][5].piece, type(b.squares[7][7].piece)))\
print("Board updated without exception.")\
PY
